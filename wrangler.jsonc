{
  // Restored from the config deleted on 13 Apr 2026 (commit 3eb5783), with three additions:
  // `main` (this is a Worker again, not assets-only), `assets.directory`, and the KV binding.
  //
  // ⚠️ `run_worker_first` is the whole point. With static assets, Cloudflare serves the assets
  // *and the SPA fallback* BEFORE the Worker script — so without this list `/api/projects`
  // returns the app HTML and src/worker.ts never runs. Every path the Worker owns is listed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/projects/*", "/sitemap.xml"]
  },
  "kv_namespaces": [
    {
      // Replace with the id of the `portfolio-projects` namespace (see the work item's
      // credentials checklist). Publishing is impossible until this is real — deliberately.
      "binding": "PROJECTS",
      "id": "REPLACE_WITH_portfolio-projects_NAMESPACE_ID"
    }
  ],
  "compatibility_flags": ["nodejs_compat"]
}
