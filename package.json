{
  "name": "prakash-sewani-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --port=3000",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "node --test tests/*.test.mjs",
    "normalize": "node scripts/normalize-content.mjs",
    "check": "npm run lint && npm run check:tokens && npm test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
